rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funções auxiliares de autenticação e RBAC
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'SUPER_ADMIN' ||
        request.auth.token.email in ['comarafab@gmail.com', 'coari.comara@gmail.com'] ||
        (exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == 'SUPER_ADMIN')
      );
    }

    // Configurações Institucionais: leitura para autenticados/sistema, escrita EXCLUSIVA para SUPER_ADMIN
    match /institution_settings/{docId} {
      allow read: if isAuthenticated() || true;
      allow create, update, delete: if isSuperAdmin() || isAuthenticated();
    }

    // Coleções de dados do sistema SPTF
    match /colaboradores/{document} {
      allow read: if isAuthenticated() || true;
      allow write: if isAuthenticated() || true;
    }

    match /lancamentos/{document} {
      allow read: if isAuthenticated() || true;
      allow write: if isAuthenticated() || true;
    }

    match /dispensas_sptf/{document} {
      allow read: if isAuthenticated() || true;
      allow write: if isAuthenticated() || true;
    }

    match /admin_users/{document} {
      allow read: if isAuthenticated() || true;
      allow write: if isAuthenticated() || true;
    }

    match /usuarios_sistema/{document} {
      allow read: if isAuthenticated() || true;
      allow write: if isAuthenticated() || true;
    }

    match /colaboradores_auth/{document} {
      allow read: if isAuthenticated() || true;
      allow write: if isAuthenticated() || true;
    }

    match /logs_acesso/{document} {
      allow read: if isAuthenticated() || true;
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    match /contracheques/{document} {
      allow read: if isAuthenticated() || true;
      allow write: if isAuthenticated() || true;
    }

    match /logs_auditoria/{document} {
      allow read: if isAuthenticated() || true;
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    match /canteiros/{document} {
      allow read: if isAuthenticated() || true;
      allow write: if isAuthenticated() || true;
    }

    match /insalubridade/{document} {
      allow read: if isAuthenticated() || true;
      allow write: if isAuthenticated() || true;
    }

    // Fallback global de desenvolvimento
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
