rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() &&
        request.auth.token.email != null &&
        (
          request.auth.token.email.lower() == 'coari.comara@gmail.com' ||
          request.auth.token.email.lower() == 'comarafab@gmail.com' ||
          request.auth.token.email.lower().matches('.*juliocesar.*') ||
          request.auth.token.email.lower().matches('.*@comara\\.(mil|aer\\.mil|gov)\\.br$') ||
          (
            exists(/databases/$(database)/documents/admin_users/$(request.auth.token.email.lower())) &&
            get(/databases/$(database)/documents/admin_users/$(request.auth.token.email.lower())).data.role == 'SUPER_ADMIN'
          )
        );
    }

    match /colaboradores/{doc} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /contracheques/{doc} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /lancamentos/{doc} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /dispensas_sptf/{doc} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /system_config/{doc} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /institution_settings/{doc} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /canteiros/{doc} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /canteiros_obras/{doc} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /insalubridade/{doc} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /insalubridade_records/{doc} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /logs_acesso/{doc} {
      allow read: if true;
      allow write: if true;
    }

    match /admin_users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || (
        isAuthenticated() &&
        request.auth.token.email != null &&
        (request.auth.token.email.lower() == userId.lower() || request.auth.uid == userId)
      );
      allow delete: if isSuperAdmin();
    }

    match /usuarios_sistema/{doc} {
      allow read, write: if isSuperAdmin();
    }
    match /system_logs/{doc} {
      allow read, write: if isSuperAdmin();
    }
    match /logs/{doc} {
      allow read, write: if isSuperAdmin();
    }
  }
}

