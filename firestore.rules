rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Configurações Globais do Sistema e Institucionais (Logo COMARA, sedes, parâmetros)
    match /system_config/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /institution_settings/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Gestão de Canteiros de Obras e Sedes
    match /canteiros_obras/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Colaboradores e Cadastro Central
    match /colaboradores/{colaboradorId} {
      allow get: if true;
      allow list: if true;
      allow write: if isAuthenticated();
    }

    // Autenticação dos Colaboradores (Portal do Colaborador)
    match /colaboradores_auth/{matriculaId} {
      allow get: if true;
      allow list: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Lançamentos e Ocorrências de Banco de Horas
    match /lancamentos/{lancamentoId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Dispensas de SPTF e Guias de 2 Vias
    match /dispensas_sptf/{dispensaId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Contracheques Digitais
    match /contracheques/{contrachequeId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Insalubridade e Registros de Exposição
    match /insalubridade_records/{recordId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Resumos Mensais Consolidados
    match /resumo_mensal/{resumoId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Usuários Administrativos e Gestores RH (RBAC)
    match /admin_users/{adminId} {
      allow read, write: if isAuthenticated();
    }

    match /usuarios_sistema/{usuarioId} {
      allow read, write: if isAuthenticated();
    }

    // Trilha de Auditoria e Logs de Sistema
    match /system_logs/{logId} {
      allow read, write: if isAuthenticated();
    }

    match /logs_auditoria/{auditId} {
      allow read, write: if isAuthenticated();
    }

    match /logs_acesso/{logId} {
      allow read, write: if isAuthenticated();
    }

    // Fallback defensivo para qualquer outra coleção
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}

